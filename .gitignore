# Raw and cleaned data files are too large for GitHub.
# The README explains how to download the raw data yourself.
data/raw/*
data/clean/*
!data/raw/.gitkeep
!data/clean/.gitkeep
# Small population tables (under 10 KB) are kept so the project runs without extra downloads
!data/raw/population_*.csv

# Compressed downloads
*.zip
*.gz

# Local database credentials and settings
.env
.pgpass

# OS and editor clutter
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
